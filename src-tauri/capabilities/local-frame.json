{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local-frame",
  "description": "Window dragging for the localhost NiceGUI frame only.",
  "windows": ["main"],
  "local": false,
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-select-chat-files",
    "allow-save-tool-output",
    "dialog:allow-open",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
