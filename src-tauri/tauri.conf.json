{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calabash",
  "mainBinaryName": "Calabash",
  "version": "../package.json",
  "identifier": "local.calabash.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:web:dev",
    "beforeBuildCommand": "npm run desktop:web:build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Calabash",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/calabash-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
