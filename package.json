{
  "name": "calabash-desktop",
  "productName": "Calabash",
  "version": "1.3.0",
  "private": true,
  "license": "Elastic-2.0",
  "keywords": [
    "ai-agent",
    "desktop-app",
    "app-builder",
    "personal-tools",
    "productivity",
    "local-first",
    "python",
    "source-available",
    "fastapi",
    "electron",
    "react"
  ],
  "type": "module",
  "scripts": {
    "electron:prepare": "node scripts/harness.mjs prepare",
    "electron:build": "node scripts/harness.mjs build",
    "electron:dev": "node scripts/harness.mjs start",
    "test:harness": "node --test tests/harness_launcher.test.mjs && node electron/tests/host-state.test.mjs && node electron/tests/bridge-exit.test.mjs && node electron/tests/extension-defaults.test.mjs && node electron/tests/ui-styles.test.mjs && node electron/tests/agent-roundtrip.mjs",
    "dev": "npm run electron:dev",
    "build": "npm run electron:build",
    "test:python": "python3 -m unittest discover -s tests"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.7.0",
    "echarts": "^6.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0"
  }
}
