{
  "name": "calabash-desktop",
  "productName": "Calabash",
  "version": "1.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "keywords": ["ai-agent", "desktop-app", "app-builder", "personal-tools", "productivity", "local-first", "tauri", "python", "nicegui", "source-available"],
  "type": "module",
  "scripts": {
    "desktop:web:dev": "vite desktop-ui --host 127.0.0.1",
    "desktop:web:build": "vite build desktop-ui",
    "desktop:backend:build": "uv run --group desktop python scripts/build_desktop_sidecar.py",
    "desktop:dev": "tauri dev",
    "desktop:build": "npm run desktop:backend:build && tauri build --verbose",
    "desktop:bundle": "tauri bundle --verbose"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^7.0.0"
  }
}
